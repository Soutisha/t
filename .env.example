# Copy to .env and replace every CHANGE_ME value with unique secrets.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD_MIN_24_CHARS
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_MIN_24_CHARS
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_MIN_24_CHARS
MINIO_APP_USER=pitstop-api
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
CLIENT_FINGERPRINT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
CORS_ORIGINS=CHANGE_ME_HTTPS_ORIGIN
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=CHANGE_ME_E164_NUMBER
METRICS_TOKEN=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
S3_SERVER_SIDE_ENCRYPTION=
MINIO_APP_PASSWORD=CHANGE_ME_MINIO_APP_PASSWORD_MIN_32_CHARS

# Retention windows are disabled by default (0). Set only after data-owner approval.
OTP_RETENTION_HOURS=0
SECURITY_AUDIT_RETENTION_DAYS=0
USER_ACTIVITY_RETENTION_DAYS=0
