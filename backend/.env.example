APP_ENV=development
APP_NAME=EUROGRIP PITSTOP OS API
DATABASE_URL=sqlite:///./pitstop_dev.db
JWT_SECRET=replace-this-with-a-long-random-secret-before-any-shared-deployment
JWT_TTL_MINUTES=60
OTP_TTL_MINUTES=5
OTP_DEV_RETURN_CODE=true
CORS_ORIGINS=http://localhost:5173
TRUSTVISION_STORAGE_DIR=./var/trustvision
TRUSTVISION_MAX_UPLOAD_BYTES=10485760
TRUSTVISION_OCR_ENABLED=true
RAG_EMBEDDING_PROVIDER=hashing
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSIONS=384
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=180
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.12
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=
RAG_LLM_TIMEOUT_SECONDS=25

# Security hardening — replace placeholders with independently generated secrets.
JWT_ISSUER=eurogrip-pitstop-os
JWT_AUDIENCE=eurogrip-pitstop-api
CLIENT_FINGERPRINT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
AUDIT_LOG_ENABLED=true

# Cloud / enterprise integration settings
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_DIR=./var/objects
S3_BUCKET=
S3_REGION=
S3_PREFIX=pitstop
S3_ENDPOINT_URL=
REDIS_URL=
CLOUD_SERVICE_NAME=pitstop-api
CLOUD_LOG_LEVEL=INFO

# Container deployment variables (copy to project-root .env, then generate unique secrets)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
JWT_SECRET=
CLIENT_FINGERPRINT_SECRET=
CORS_ORIGINS=https://your-approved-frontend.example

# Required for production OTP delivery
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=replace-with-account-sid
TWILIO_AUTH_TOKEN=replace-with-auth-token
TWILIO_FROM_NUMBER=+10000000000
METRICS_TOKEN=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
